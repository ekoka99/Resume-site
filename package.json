{
  "name": "elio-koka-resume-site",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build": "npm run compile && next build --webpack && npm run sitemap",
    "check": "npm run lint && npm run build",
    "clean": "rm -rf build-tsc .next out",
    "compile": "tsc --noEmit",
    "dev": "next dev",
    "format": "prettier --write './src/**/*.{js,jsx,json,ts,tsx}'",
    "lint": "prettier --check './src/**/*.{js,jsx,json,ts,tsx}' && eslint './src/**/*.{js,jsx,ts,tsx}' --max-warnings=0",
    "sitemap": "next-sitemap --config next-sitemap.config.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "classnames": "^2.3.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.4.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "next-sitemap": "^4.2.3",
    "postcss": "8.5.25",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.102.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "picomatch": "2.3.2",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
